    {
      "name": "installations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installations\" (\"id\" TEXT NOT NULL, \"created_at_utc_micros\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "raw_captures",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"raw_captures\" (\"capture_id\" TEXT NOT NULL, \"raw_text\" TEXT NOT NULL, \"payload_kind\" TEXT NOT NULL DEFAULT 'text', \"source_installation_id\" TEXT NOT NULL REFERENCES installations (id), \"captured_at_utc_micros\" INTEGER NOT NULL, \"original_offset_minutes\" INTEGER NOT NULL, \"source_time_zone_id\" TEXT NULL, \"visibility\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, \"created_at_utc_micros\" INTEGER NOT NULL, PRIMARY KEY (\"capture_id\"), CHECK ((payload_kind = 'text' AND length(raw_text) > 0) OR (payload_kind = 'voice' AND raw_text = '')), CHECK (visibility = 'private'), CHECK (revision = 1));"
        }
      ]
    },
    {
      "name": "raw_media",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"raw_media\" (\"media_id\" TEXT NOT NULL, \"capture_id\" TEXT NOT NULL UNIQUE REFERENCES raw_captures (capture_id) ON DELETE CASCADE, \"relative_path\" TEXT NOT NULL UNIQUE, \"sha256\" TEXT NOT NULL, \"byte_length\" INTEGER NOT NULL, \"mime_type\" TEXT NULL, \"codec\" TEXT NULL, \"duration_millis\" INTEGER NULL, \"created_at_utc_micros\" INTEGER NOT NULL, PRIMARY KEY (\"media_id\"), CHECK (length(relative_path) > 0), CHECK (length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'), CHECK (byte_length > 0), CHECK (duration_millis IS NULL OR duration_millis >= 0));"
        }
      ]
    },
